# =====================================================
# TIN HOC GEN Z - ENVIRONMENT TEMPLATE
# Copy to .env.local for local development.
# Never commit real secrets.
# =====================================================

# Public site
NEXT_PUBLIC_SITE_URL=https://tinhocgenz.io.vn
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Admin authentication (server only)
# Generate a random value of at least 32 characters.
ADMIN_SESSION_SECRET=
# JSON object keyed by username. Use unique passwords (minimum 12 characters).
# Example structure only - replace every value before use.
ADMIN_USER_PASSWORDS_JSON={}
# Six-digit backup MFA code for privileged admin accounts.
ADMIN_MFA_BACKUP_CODE=

# Cron / automation security (server only)
CRON_SECRET=

# Supabase - configure when Supabase-backed features are enabled
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Contact form integration
GOOGLE_SCRIPT_URL=

# Content Engine AI providers
DEFAULT_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Collector settings
CRAWLER_USER_AGENT=TinHocGenZ-ContentEngine/1.0 (+https://tinhocgenz.io.vn)
MAX_ITEMS_PER_FETCH=10
